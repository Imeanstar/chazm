//@version=5
// 산 / 구덩이(골파기) 지표 — 텔레그램 채널 방장 "주황 지표 (cci, 수정값)" 복제판
//
// 확인된 사실 (채널 글 11,105건 분석):
//  - 방장이 2025-03-13 글에서 "주황 지표 (cci, 수정값)"이라고 직접 밝혔다.
//  - 산 = +100 위(과매수), 구덩이 = -100 아래(과매도). 깊은 구덩이는 -200 ~ -400.
//  - 패널이 단기 / 중기 / 장기 세 개다. 글에서 주로 인용하는 "일봉 수치"는 가운데 중기 값이다.
//  - 4시간봉에서 인용한 값 두 개(-87, -79)는 표준 CCI(20)과 2~5점 차이로 일치했다.
//  - 일봉 중기 값 18개는 "평균 58봉, 표준편차 50봉" 설정과 배율 보정 없이 맞았다(오차 ±8).
//  - 주봉 값 두 개(BTC -11, ETH -32)는 길이 10~11주로 맞았다.
//  - 시간대별 추천 길이: 15분/1시간/4시간 = 20, 일봉 = 58/50(std), 주봉 = 10~11.
//
// 사용법: 일봉 차트에 올리고 가운데(중기) 선을 본다. 4시간/1시간 차트에서는 단기 선을 본다.

indicator("산/구덩이 CCI (단기/중기/장기)", shorttitle="산구덩이", overlay=false)

// ---- 입력 ----
src       = input.source(hlc3, "소스")
devType   = input.string("std", "편차 방식", options=["mad", "std"], tooltip="mad = 표준 CCI(평균절대편차), std = 표준편차")
showS     = input.bool(true,  "단기 표시")
lenS      = input.int(20, "단기 길이", minval=2)
devS      = input.int(20, "단기 편차 길이", minval=2)
showM     = input.bool(true,  "중기 표시")
lenM      = input.int(58, "중기 평균 길이", minval=2)
devM      = input.int(50, "중기 편차 길이", minval=2)
showL     = input.bool(false, "장기 표시")
lenL      = input.int(120, "장기 평균 길이", minval=2)
devL      = input.int(100, "장기 편차 길이", minval=2)
htfOn     = input.bool(false, "중기를 다른 시간대로 계산")
htfTf     = input.timeframe("D", "그 시간대")
obLvl     = input.float(100, "산 기준")
osLvl     = input.float(-100, "구덩이 기준")

// ---- 수정 CCI: 평균 길이와 편차 길이를 따로 둔다 ----
f_cci(_src, _lenMean, _lenDev, _devType) =>
    _ma = ta.sma(_src, _lenMean)
    _dev = _devType == "mad" ? ta.dev(_src, _lenDev) : ta.stdev(_src, _lenDev)
    (_src - _ma) / (0.015 * _dev)

cciS = f_cci(src, lenS, devS, devType)
cciM_local = f_cci(src, lenM, devM, devType)
cciM = htfOn ? request.security(syminfo.tickerid, htfTf, cciM_local, lookahead=barmerge.lookahead_off) : cciM_local
cciL = f_cci(src, lenL, devL, devType)

// ---- 상태 (중기 기준) ----
isMountain = cciM >= obLvl
isPit      = cciM <= osLvl
turningDown = ta.barssince(isMountain) <= 3 and cciM < cciM[1] and cciM < obLvl
turningUp   = ta.barssince(isPit) <= 3 and cciM > cciM[1] and cciM > osLvl

// ---- 그리기 ----
plot(showS ? cciS : na, "단기", color=color.new(color.gray, 30), linewidth=1)
plot(showM ? cciM : na, "중기 (주황)", color=color.orange, linewidth=2)
plot(showL ? cciL : na, "장기", color=color.new(color.blue, 0), linewidth=2)
hline(0, "0", color=color.gray)
hline(obLvl, "산", color=color.new(color.red, 40))
hline(osLvl, "구덩이", color=color.new(color.green, 40))
hline(-200, "-200", color=color.new(color.green, 70), linestyle=hline.style_dotted)
hline(200, "+200", color=color.new(color.red, 70), linestyle=hline.style_dotted)
bgcolor(isMountain ? color.new(color.red, 85) : isPit ? color.new(color.green, 85) : na)
plotshape(turningDown, "산 뒤 꺾임", style=shape.triangledown, location=location.top, color=color.red, size=size.tiny)
plotshape(turningUp, "구덩이 뒤 반등", style=shape.triangleup, location=location.bottom, color=color.green, size=size.tiny)

// ---- 알림 ----
alertcondition(isMountain and not isMountain[1], "산 진입", "중기 CCI가 과매수권(산)에 들어갔다")
alertcondition(isPit and not isPit[1], "구덩이 진입", "중기 CCI가 과매도권(구덩이)에 들어갔다")
alertcondition(turningDown, "산 뒤 꺾임", "산을 만든 뒤 중기 CCI가 꺾이기 시작했다")
alertcondition(turningUp, "구덩이 뒤 반등", "구덩이 뒤 중기 CCI가 올라오기 시작했다")
